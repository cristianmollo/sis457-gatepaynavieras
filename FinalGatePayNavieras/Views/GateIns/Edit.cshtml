@model FinalGatePayNavieras.Models.GateIn

@{
    ViewData["Title"] = "Editar GateIn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0">Editar Registro GateIn</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="IdCliente" class="form-label fw-bold"></label>
                    <select asp-for="IdCliente" class="form-select" asp-items="ViewBag.IdCliente"></select>
                    <span asp-validation-for="IdCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdNaviera" class="form-label fw-bold"></label>
                    <select asp-for="IdNaviera" class="form-select" asp-items="ViewBag.IdNaviera"></select>
                    <span asp-validation-for="IdNaviera" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NumeroBl" class="form-label fw-bold"></label>
                    <input asp-for="NumeroBl" class="form-control" />
                    <span asp-validation-for="NumeroBl" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contenedor" class="form-label fw-bold"></label>
                    <input asp-for="Contenedor" class="form-control" />
                    <span asp-validation-for="Contenedor" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MontoPago" class="form-label fw-bold"></label>
                    <input asp-for="MontoPago" class="form-control" />
                    <span asp-validation-for="MontoPago" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MetodoPago" class="form-label fw-bold"></label>
                    <input asp-for="MetodoPago" class="form-control" />
                    <span asp-validation-for="MetodoPago" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaPago" class="form-label fw-bold"></label>
                    <input asp-for="FechaPago" class="form-control" />
                    <span asp-validation-for="FechaPago" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdUsuario" class="form-label fw-bold"></label>
                    <select asp-for="IdUsuario" class="form-select" asp-items="ViewBag.IdUsuario"></select>
                    <span asp-validation-for="IdUsuario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UsuarioRegistro" class="form-label fw-bold"></label>
                    <input asp-for="UsuarioRegistro" class="form-control" />
                    <span asp-validation-for="UsuarioRegistro" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaRegistro" class="form-label fw-bold"></label>
                    <input asp-for="FechaRegistro" class="form-control" />
                    <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label fw-bold"></label>
                    <input asp-for="Estado" class="form-control" />
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    <input type="submit" value="Guardar Cambios" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
