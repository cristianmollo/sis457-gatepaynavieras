@model FinalGatePayNavieras.Models.GateIn

@{
    ViewData["Title"] = "Detalles de GateIn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Detalles del registro - GateIn</h4>
        </div>
        <div class="card-body">
            <dl class="row">

                <dt class="col-sm-3">Número BL</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.NumeroBl)</dd>

                <dt class="col-sm-3">Contenedor</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Contenedor)</dd>

                <dt class="col-sm-3">Monto del Pago</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MontoPago)</dd>

                <dt class="col-sm-3">Método de Pago</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.MetodoPago)</dd>

                <dt class="col-sm-3">Fecha del Pago</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaPago)</dd>

                <dt class="col-sm-3">Usuario de Registro</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.UsuarioRegistro)</dd>

                <dt class="col-sm-3">Fecha de Registro</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaRegistro)</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Estado)</dd>

                <dt class="col-sm-3">Cliente</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.IdClienteNavigation.Id)</dd>

                <dt class="col-sm-3">Naviera</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.IdNavieraNavigation.Id)</dd>

                <dt class="col-sm-3">Usuario</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.IdUsuarioNavigation.Id)</dd>
            </dl>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
        </div>
    </div>
</div>
