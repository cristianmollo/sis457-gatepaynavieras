@model IEnumerable<FinalGatePayNavieras.Models.GateIn>

@{
    ViewData["Title"] = "Lista de GateIns";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Registros de GateIn</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Registro
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().NumeroBl)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Contenedor)</th>
                    <th>@Html.DisplayNameFor(model => model.First().MontoPago)</th>
                    <th>@Html.DisplayNameFor(model => model.First().MetodoPago)</th>
                    <th>@Html.DisplayNameFor(model => model.First().FechaPago)</th>
                    <th>@Html.DisplayNameFor(model => model.First().UsuarioRegistro)</th>
                    <th>@Html.DisplayNameFor(model => model.First().FechaRegistro)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Estado)</th>
                    <th>Cliente</th>
                    <th>Naviera</th>
                    <th>Usuario</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.NumeroBl)</td>
                        <td>@Html.DisplayFor(m => item.Contenedor)</td>
                        <td>@Html.DisplayFor(m => item.MontoPago)</td>
                        <td>@Html.DisplayFor(m => item.MetodoPago)</td>
                        <td>@Html.DisplayFor(m => item.FechaPago)</td>
                        <td>@Html.DisplayFor(m => item.UsuarioRegistro)</td>
                        <td>@Html.DisplayFor(m => item.FechaRegistro)</td>
                        <td>@Html.DisplayFor(m => item.Estado)</td>
                        <td>@item.IdClienteNavigation?.Nombre</td>
                        <td>@item.IdNavieraNavigation?.Nombre</td>
                        <td>@item.IdUsuarioNavigation?.Id</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Ver</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
