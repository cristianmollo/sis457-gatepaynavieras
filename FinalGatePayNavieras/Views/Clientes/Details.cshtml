@model FinalGatePayNavieras.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-vcard-fill"></i> Detalles del Cliente
                    </h4>
                </div>
                <div class="card-body">

                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th>Nombre</th>
                                <td>@Model.Nombre</td>
                            </tr>
                            <tr>
                                <th>Teléfono</th>
                                <td>@Model.Telefono</td>
                            </tr>
                            <tr>
                                <th>Correo Electrónico</th>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <th>Tipo de Cliente</th>
                                <td>@Model.TipoCliente</td>
                            </tr>
                            <tr>
                                <th>Registrado por</th>
                                <td>@Model.UsuarioRegistro</td>
                            </tr>
                            <tr>
                                <th>Fecha de Registro</th>
                                <td>@Model.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <th>Estado</th>
                                <td>@Model.Estado</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left-circle"></i> Volver
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info text-white">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
