@model FinalGatePayNavieras.Models.Cliente

@{
    ViewData["Title"] = "Crear Nuevo Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h1 class="mb-4"><i class="bi bi-plus-circle"></i> Editar Cliente</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Create" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TipoCliente" class="form-label"></label>
                    <input asp-for="TipoCliente" class="form-control" />
                    <span asp-validation-for="TipoCliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UsuarioRegistro" class="form-label"></label>
                    <input asp-for="UsuarioRegistro" class="form-control" />
                    <span asp-validation-for="UsuarioRegistro" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaRegistro" class="form-label"></label>
                    <input asp-for="FechaRegistro" type="date" class="form-control" />
                    <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="1" selected>Activo</option>
                        <option value="0">Inactivo</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Actualizar Cliente</button>
                </div>
            </form>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
