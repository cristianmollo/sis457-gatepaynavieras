@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(to right, #1e3c72, #2a5298); /* fondo azul marino degradado */
        color: #fff;
    }

    .login-container {
        max-width: 400px;
        margin: 80px auto;
        background-color: rgba(0, 0, 0, 0.6);
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
    }

        .login-container h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #ffffff;
        }

    .form-control {
        background-color: #f2f2f2;
        color: #000;
    }

    .btn-primary {
        background-color: #0066cc;
        border-color: #005bb5;
    }

        .btn-primary:hover {
            background-color: #005bb5;
        }

    a {
        color: #a0c4ff;
    }

        a:hover {
            color: #ffffff;
            text-decoration: underline;
        }

    .checkbox label {
        color: #ccc;
    }
</style>

<div class="login-container">
    <h2>Iniciar Sesión</h2>

    <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" aria-live="assertive"></div>

        <div class="form-group">
            <label asp-for="usuario" class="control-label"></label>
            <input asp-for="usuario" class="form-control" placeholder="Usuario" required autofocus autocomplete="username" />
            <span asp-validation-for="usuario" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="clave" class="control-label"></label>
            <input asp-for="clave" type="password" class="form-control" placeholder="Contraseña" required autocomplete="current-password" />
            <span asp-validation-for="clave" class="text-danger"></span>
        </div>

        <div class="form-group form-check d-flex align-items-center">
            <input type="checkbox" name="recordarme" id="recordarme" class="form-check-input mr-2" />
            <label for="recordarme" class="form-check-label mb-0">Recordarme</label>
        </div>

        <div class="form-group text-center">
            <input type="submit" value="Iniciar Sesión" class="btn btn-primary btn-block" onclick="this.value='Cargando...'; this.disabled=true; this.form.submit();" />
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Account" asp-action="ResetPassword">¿Olvidaste tu contraseña?</a>
        </div>
    </form>
</div>
